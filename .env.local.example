# Upstash Redis — powers recipe ratings (app/api/rating).
# Easiest: add the Upstash integration in Vercel (Storage tab), then run
# `vercel env pull .env.local`. It provides the KV_REST_API_* vars below.
# Only the URL + full-access TOKEN are used; the read-only token is not needed.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternative names (plain Upstash console) — either set is accepted:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
